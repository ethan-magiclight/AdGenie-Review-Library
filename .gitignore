.DS_Store
node_modules/
dist/
build/
.next/
.vite/

# Local runtime state backups generated by web/scripts/backup-state.mjs
web/data/backups/

# Local spreadsheet inspection artifacts
*.inspect.ndjson

# Historical workbook/render outputs; keep curated docs in docs/ instead.
outputs/
.codex-spreadsheets/
.impeccable/

# Legacy prototype workspace and generated demo media.
demo/
tools/

# Downloaded/generated video review media. The review app can fall back to
# YouTube thumbnails and online embeds; keep JSON/Markdown facts in collect/.
collect/**/videos/
collect/**/frames/
collect/**/individual/
collect/**/batches/
*.mp4
*.mov
*.webm

# Logs and local temp files
*.log
*.tmp
*.bak

# Environment files; provide secrets through environment variables.
.env
.env.*

# Python caches
__pycache__/
*.pyc
