{
  "version": 2,
  "builds": [
    {
      "src": "review-console/release/web/server.mjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "review-console/release/web/public/**",
          "review-console/release/web/lib/**",
          "review-console/release/web/data/creative-library-state.json",
          "review-console/release/collect/**/*.json",
          "review-console/release/collect/**/*.jpg",
          "review-console/release/collect/**/*.jpeg",
          "review-console/release/collect/**/*.png"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "review-console/release/web/server.mjs"
    }
  ]
}
